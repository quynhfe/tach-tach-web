# Cùng project Supabase với app Tách Tách.
# Lấy ở: Supabase Dashboard -> Project Settings -> API
# Anon key vốn thiết kế để public (RLS mới là lớp bảo vệ) — KHÔNG dùng service key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Gốc URL của chính trang này — dùng dựng absolute URL cho OG meta.
NEXT_PUBLIC_SITE_URL=https://tachtach.vercel.app

# Mapbox public token (pk.…) — cùng token với app. Không có thì tab Bản đồ hiện
# lời nhắc thay vì màn trắng.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.xxx

# (Tuỳ chọn) Style riêng tạo trên Mapbox Studio; bỏ trống thì dùng style cream
# tự chứa trong lib/map-style.ts.
NEXT_PUBLIC_MAPBOX_STYLE_URL=

# Link store — để trống tới khi app lên store; banner tự ẩn nút.
NEXT_PUBLIC_APP_STORE_URL=
