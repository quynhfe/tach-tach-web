# Cùng project Supabase với app Tách Tách.
# Lấy ở: Supabase Dashboard -> Project Settings -> API
# Anon key vốn thiết kế để public (RLS mới là lớp bảo vệ) — KHÔNG dùng service key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Gốc URL của chính trang này — dùng dựng absolute URL cho OG meta.
NEXT_PUBLIC_SITE_URL=https://tachtach.vercel.app

# Mapbox public token (pk.…) — cùng token với app. Không có thì tab Bản đồ hiện
# lời nhắc thay vì màn trắng.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.xxx

# (Tuỳ chọn) Style Mapbox Studio dạng "user/styleid" cho ảnh bản đồ tĩnh. Bỏ
# trống thì dùng mapbox/light-v11 — Static Images API không nhận style JSON rời
# nên không dùng lại được style cream của app.
NEXT_PUBLIC_MAPBOX_STATIC_STYLE=

# Nơi tải app. Chưa lên store thì điền LINK TESTFLIGHT công khai
# (https://testflight.apple.com/join/XXXXXXXX) — ai bấm cũng vào được.
# Để trống thì banner và nút "Chỉ đường" tự ẩn, không dựng nút bấm vào hư không.
NEXT_PUBLIC_APP_STORE_URL=
